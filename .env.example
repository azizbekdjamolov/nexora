# ============================================================
# Vitalis — AI Health, Sport & Wellness platform
# Copy this file to .env (api/.env, bot/.env, web/.env.local)
# NEVER commit real secrets.
# ============================================================

# ---------- Application ----------
SITE_NAME="Vitalis"
SITE_DESCRIPTION="AI Health, Sport & Wellness — website, Telegram Bot and Mini App on one shared engine."
SITE_URL="http://localhost:3000"
# Default locale: uz | en | ru
DEFAULT_LOCALE="en"
# Comma separated: uz,en,ru
SUPPORTED_LOCALES="uz,en,ru"

# ---------- API ----------
API_PORT=4000
API_URL="http://localhost:4000"
# Absolute URL of the website (used for deep links)
WEB_URL="http://localhost:3000"

# Session cookie secret used to sign integrity marker.
# IMPORTANT: must be a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-string"

# Comma separated list of allowed origins (browser).
CORS_ORIGINS="http://localhost:3000"

# Shared secret used by the Telegram Bot process to call service endpoints.
# The bot and the API must use the SAME value.
BOT_SERVICE_TOKEN="change-me-to-a-random-bot-service-token"

# ---------- Database ----------
# SQLite (default, zero-config dev)
DATABASE_URL="file:./dev.db"
# PostgreSQL (production): uncomment and adjust, then set provider in prisma/schema.prisma
# DATABASE_URL="postgresql://user:password@localhost:5432/vitalis?schema=public"

# ---------- Telegram ----------
# From @BotFather
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
TELEGRAM_BOT_USERNAME="MyVitalisBot"
# Public URL where the Mini App is hosted (must be HTTPS in production)
TELEGRAM_MINI_APP_URL="http://localhost:3000/mini"
# Optional: webhook URL if you switch bot to webhook mode (empty = long polling)
TELEGRAM_BOT_WEBHOOK_URL=""

# ---------- AI (server-side only, never exposed to clients) ----------
# Provider: openai | groq | gemini | anthropic
# Recommended free dev combo: provider gemini + model gemini-2.5-flash
AI_PROVIDER="gemini"
AI_API_KEY=""
AI_MODEL="gemini-2.5-flash"
# Per-provider keys (used when AI_API_KEY is empty). Only the configured provider's key is required.
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""